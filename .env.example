# Copy to .env.local for local runs. Netlify needs the same vars set in
# Site settings → Environment variables (all of them, including the
# NEXT_PUBLIC_* ones, since Netlify builds in a clean environment).

# --- Supabase (shared with the newtest environment) ---
NEXT_PUBLIC_SUPABASE_URL=https://droqeosuxenldeiytveo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this to the browser; used by lib/supabase/service.ts
# to write purchase records that RLS would otherwise reject.
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack (native fetch, no SDK) ---
# Secret key from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=

# --- Misc ---
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_NEWSDATA_API_KEY=
